# ===================================
# PrantiX Environment Variables
# ===================================
# INSTRUCTIONS:
# 1. Copy this file to .env (NOT .env.example)
# 2. Fill in your actual values
# 3. NEVER commit .env to Git (.gitignore blocks it)
# 4. For Azure deployment, add these in Azure Portal → App Service → Configuration
# ===================================

# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-new-one
DJANGO_SETTINGS_MODULE=prantix.settings
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Local Development - SQLite)
# For Azure, these will be overridden by Azure-provided values
DATABASE_URL=sqlite:///db.sqlite3

# Azure PostgreSQL (Production - Set in Azure Portal)
DBNAME=prantix_db
DBHOST=your-server-name.postgres.database.azure.com
DBUSER=your-admin-username
DBPASS=your-database-password

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Razorpay Payment Gateway
# IMPORTANT: Use TEST keys for development, LIVE keys for production
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_key_secret_here

# UPI Payment Settings
UPI_ID=your-upi-id@bank
QR_CODE_PATH=files/qr_code.png

# Twilio SMS (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Azure Blob Storage (Optional - for media files)
AZURE_ACCOUNT_NAME=your-storage-account
AZURE_ACCOUNT_KEY=your-storage-key
AZURE_CONTAINER=media

# Azure Application Insights (Optional - for monitoring)
APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key

# Website Configuration
WEBSITE_HOSTNAME=localhost:8000
